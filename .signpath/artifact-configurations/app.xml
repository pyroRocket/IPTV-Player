<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the Windows app folder from CI.
     Signs only our own executable; third-party DLLs (Flutter, mpv, VC++) stay as shipped. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="iptv_player.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
